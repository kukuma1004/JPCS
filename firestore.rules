rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  기록실 (Girokshil) — Firestore 보안 규칙
//
//  방어선 요약
//   1. 학교 간 격리 — 소속 학교(schoolId)가 다르면 문서 자체가 안 보임
//   2. 학생은 "본인 학습일지"만. 다른 학생, 생기부 기록, 상담, 브리핑 전부 차단
//   3. 생기부 기록(records)·상담(counsels)·브리핑(briefs)은 교사 전용
//   4. 역할(role)·소속(schoolId)·담당학급(classes)은 관리자만 변경 가능
//   5. codes / shares 는 문서 ID 자체가 비밀 — get만 허용, list(전수조회) 차단
//
//  ※ 교사 간 담당 학급 분리에 대하여
//     "3학년 2반 담당 교사는 3학년 2반 학생만 본다"는 규칙은 앱 화면 수준에서
//     적용됩니다. 규칙 수준에서 문서마다 담당 학급을 대조하려면 문서 읽기가
//     기하급수적으로 늘어 실용적이지 않기 때문입니다.
//     같은 학교 교직원은 원래 NEIS에서도 서로의 담당 학생 정보에 접근 가능한
//     위치이므로, 이 시스템도 "학교 단위 격리 + 화면 단위 담당 분리"를
//     기준으로 삼습니다. 학교 밖으로는 어떤 경로로도 새어나가지 않습니다.
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ────────────────────────────────────────────────────
    function signedIn()  { return request.auth != null; }
    function me()        { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole()    { return me().role; }
    function mySchool()  { return me().schoolId; }
    function myStudent() { return me().get('studentId', ''); }

    function isTeacherOf(sid) {
      return signedIn() && mySchool() == sid && (myRole() == 'teacher' || myRole() == 'admin');
    }
    function isAdminOf(sid) {
      return signedIn() && mySchool() == sid && myRole() == 'admin';
    }
    function isStudentOf(sid) {
      return signedIn() && mySchool() == sid && myRole() == 'student';
    }
    function school(sid) {
      return get(/databases/$(database)/documents/schools/$(sid)).data;
    }
    // 호스트(운영자) — hosts/{uid} 문서는 Firebase 콘솔에서 직접 만들어야 하며
    // 앱에서는 절대 생성할 수 없다. 스스로 권한을 부여하는 경로가 없다.
    function isHost() {
      return signedIn() && exists(/databases/$(database)/documents/hosts/$(request.auth.uid));
    }
    function keeps(f) { return request.resource.data[f] == resource.data[f]; }

    // ── 사용자 프로필 ────────────────────────────────────────────
    // 본인 문서만 읽는다. 생성은 가입 시 1회이며 role을 스스로 정할 수 없다.
    //  · admin  : 방금 자기가 만든 학교(ownerUid == 본인)에 대해서만
    //  · teacher: 학교의 교사 가입코드를 정확히 제시해야만
    //  · student: codes/{코드} 문서가 실제로 그 학생을 가리켜야만
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || isAdminOf(resource.data.schoolId));
      // 관리자만 소속 학교 교사 목록을 조회할 수 있다 (담당 학급 배정 화면용).
      // 반드시 where('schoolId','==',내학교) 조건이 걸린 쿼리여야 통과한다.
      allow list:   if signedIn() && isAdminOf(resource.data.schoolId);

      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['schoolId','role'])
                    && (
                      // ① 학교 개설자 → 관리자
                      ( request.resource.data.role == 'admin'
                        && school(request.resource.data.schoolId).ownerUid == request.auth.uid )
                      ||
                      // ② 교사 가입코드 일치
                      ( request.resource.data.role == 'teacher'
                        && request.resource.data.teacherCode ==
                           school(request.resource.data.schoolId).teacherCode )
                      ||
                      // ②-2 관리자 가입코드 일치 → 그 학교의 관리자
                      ( request.resource.data.role == 'admin'
                        && request.resource.data.adminCode ==
                           school(request.resource.data.schoolId).adminCode )
                      ||
                      // ③ 학생 접속코드가 실제로 그 학생을 가리킴
                      ( request.resource.data.role == 'student'
                        && get(/databases/$(database)/documents/codes/$(request.resource.data.accessCode)).data.studentId
                           == request.resource.data.studentId
                        && get(/databases/$(database)/documents/codes/$(request.resource.data.accessCode)).data.schoolId
                           == request.resource.data.schoolId )
                    );

      // 역할·소속·담당학급 변경은 관리자만
      allow update: if isAdminOf(resource.data.schoolId)
                    && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;
    }

    // ── 접속코드 조회표 ──────────────────────────────────────────
    // 로그인 전에 읽어야 하므로 get은 공개. 단 문서 ID(6자리 코드)를 정확히
    // 알아야만 읽히고, list는 막혀 있어 전수조회가 불가능하다.
    // 담긴 값은 schoolId / studentId 뿐 — 이름·성적 등 개인정보는 없다.
    match /codes/{code} {
      allow get:    if true;
      allow list:   if false;
      allow create, update: if signedIn() && isTeacherOf(request.resource.data.schoolId);
      allow delete: if signedIn() && isTeacherOf(resource.data.schoolId);
    }

    // ── 학부모 열람 리포트 (스냅샷) ──────────────────────────────
    // 만들 때 리포트 HTML을 통째로 굳혀 저장한다. 따라서 이 문서를 읽어도
    // 살아있는 컬렉션에는 접근할 수 없고, 다른 학생 정보도 들어있지 않다.
    match /shares/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create: if signedIn() && isTeacherOf(request.resource.data.schoolId);
      allow update, delete: if signedIn() && isTeacherOf(resource.data.schoolId);
    }

    // ── 학교 ─────────────────────────────────────────────────────
    match /schools/{sid} {
      // 소속 교사·학생만 학교 문서를 읽는다(가입코드가 들어있으므로). 호스트는 전체 열람 가능.
      allow get:    if isHost() || (signedIn() && (mySchool() == sid || resource.data.ownerUid == request.auth.uid));
      allow list:   if isHost();                    // 호스트만 학교 목록 조회
      allow create: if isHost() || (signedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isHost() || isAdminOf(sid);
      // 잘못 만든 학교를 지울 수 있게. 하위 데이터는 함께 지워지지 않으므로
      // 앱에서 "학생이 있는 학교"는 삭제를 막습니다.
      allow delete: if isHost();

      // ── 학생 명부 (실명이 있는 유일한 곳) ──────────────────────
      match /students/{studentId} {
        allow get:    if isTeacherOf(sid) || (isStudentOf(sid) && myStudent() == studentId);
        allow list:   if isTeacherOf(sid);          // 학생은 목록 조회 불가
        allow create: if isTeacherOf(sid);
        // 학생 본인은 "나의 소개"(profile)와 기록 방식(logMode)만 고칠 수 있다.
        // 이름·학번·접속코드·담당 학급 같은 나머지 필드는 손대지 못한다.
        // updatedAt 은 앱이 모든 저장에 자동으로 붙이는 값이라 함께 열어둔다.
        allow update: if isTeacherOf(sid)
                      || (isStudentOf(sid) && myStudent() == studentId
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['profile','profileAt','logMode','updatedAt'])
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['logMode'])
                              || request.resource.data.logMode in ['daily','weekly']));
        allow delete: if isTeacherOf(sid);
      }

      // ── 생기부 기록 (세특·동아리·자율·진로·행특) — 교사 전용 ────
      // 학생은 읽기조차 불가. 초안 문안이 노출되면 수정 요구·민원으로 이어진다.
      match /records/{recordId} {
        allow read:   if isTeacherOf(sid);
        allow create: if isTeacherOf(sid)
                      && request.resource.data.area in ['sekteuk','dongari','jayul','jinro','haengteuk'];
        allow update: if isTeacherOf(sid);
        allow delete: if isTeacherOf(sid);
      }

      // ── 상담 기록 — 교사 전용 ─────────────────────────────────
      match /counsels/{cid} {
        allow read, write: if isTeacherOf(sid);
      }

      // ── 상담 브리핑 · 담임 코멘트 — 교사 전용 ──────────────────
      // 학생 명부와 분리해 둔 이유: 학생은 자기 명부 문서를 읽을 수 있으므로
      // 교사의 판단이 담긴 내용을 같은 문서에 두면 학생에게 노출된다.
      match /briefs/{studentId} {
        allow read, write: if isTeacherOf(sid);
      }

      // ── 학습일지 ──────────────────────────────────────────────
      // 학생: 본인 것만 / 교사: 소속 학교 전체 열람
      match /journals/{jid} {
        allow get:    if isTeacherOf(sid)
                      || (isStudentOf(sid) && resource.data.studentId == myStudent());
        // 학생의 목록 조회는 반드시 본인 studentId 조건이 걸린 쿼리여야 통과.
        //
        // ★ 예전에 여기 request.query.limit <= 500 조건이 있었는데 그것 때문에
        //   학생이 자기 학습일지를 통째로 못 읽는 사고가 났습니다.
        //   앱이 조회할 때 개수를 명시하지 않으면 이 비교가 통과하지 못합니다.
        //   아래 studentId 조건만으로도 "본인 것만" 이라는 방어는 이미 완전하므로
        //   개수 제한은 걷어냈습니다. 학생은 애초에 남의 문서를 한 건도 못 읽습니다.
        allow list:   if isTeacherOf(sid)
                      || (isStudentOf(sid) && resource.data.studentId == myStudent());

        allow create: if isStudentOf(sid)
                      && request.resource.data.studentId == myStudent()
                      && request.resource.data.date is string
                      && request.resource.data.totalMinutes is number
                      && request.resource.data.totalMinutes >= 0
                      && request.resource.data.totalMinutes <= 1440;

        allow update: if isStudentOf(sid)
                      && resource.data.studentId == myStudent()
                      && keeps('studentId') && keeps('date')
                      && request.resource.data.totalMinutes <= 1440;

        allow delete: if (isStudentOf(sid) && resource.data.studentId == myStudent())
                      || isTeacherOf(sid);
      }
    }

    // ── 호스트 명부 ─────────────────────────────────────────────
    // Firebase 콘솔에서 직접 문서를 만들어야만 호스트가 됩니다.
    // 앱에서는 만들 수도, 지울 수도, 남의 것을 볼 수도 없습니다.
    match /hosts/{uid} {
      allow get:   if signedIn() && request.auth.uid == uid;
      allow list:  if false;
      allow write: if false;
    }

    // 명시하지 않은 모든 경로 차단
    // ★ 호스트는 여기에 걸려 students/records/journals/counsels/briefs 에
    //   접근할 수 없습니다. 학교와 계정만 관리하고 학생 개인정보는 보지 못합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
